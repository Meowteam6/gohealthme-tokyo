node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.log
.DS_Store

# Native projects are generated by `expo prebuild` from app.json, so they are
# build output, not source: committing them would freeze plugin output (the
# HealthKit entitlements, Info.plist strings) and the signing team baked in by
# the last machine that built. Regenerate, do not commit.
/ios
/android

# Local TestFlight pipeline output (scripts/apple-build.sh): archive, ipa,
# ExportOptions.plist with the team id, xcodebuild and altool logs.
/build
/ios/build

# Local env (never commit real keys)
.env
.env*.local

# EAS / key material
*.pem
*-recovery-file.json

# Apple signing and submit material, never committed
.secrets/
.env.submit
