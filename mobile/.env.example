# The GoHealthMe backend this app asks for Open Wearables credentials.
# A Vercel preview URL works; so does the production alias. The app calls
# POST /api/wearable/mobile-token there, signed with the wallet below.
EXPO_PUBLIC_API_BASE=https://www.gohealthme.app

# DEV ONLY, remove once the Dynamic embedded wallet is wired in.
# A well-known zero-value test key used purely to sign the wallet-auth message
# so the pilot app can authenticate before real wallet integration. The default
# if unset is Hardhat/Anvil account #0, address
# 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266. NEVER fund this address.
EXPO_PUBLIC_DEV_SIGNER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
